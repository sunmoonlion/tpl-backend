# Runtime identity
ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=tpl-admin-backend
APP_SLUG=tpl
SURFACE=admin

# PostgreSQL. MIGRATION_DATABASE_URL is optional and should use a dedicated
# migration role. sslmode is normalized for asyncpg.
DATABASE_URL=postgresql://tpl:change-me@localhost:5432/tpl
MIGRATION_DATABASE_URL=

# Redis session/cache ACL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=

# Browser OIDC BFF. Provider tokens are never persisted in the browser session.
CASDOOR_ENDPOINT=https://identity.example.test
CASDOOR_DISCOVERY_URL=https://identity.example.test/.well-known/openid-configuration
CASDOOR_BACKCHANNEL_ENDPOINT=
CASDOOR_CLIENT_ID=replace-me
CASDOOR_CLIENT_SECRET=replace-me
CASDOOR_REDIRECT_URI=https://admin.example.test/api/auth/callback
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=sunmoonai-tpl-admin
CASDOOR_VERIFY_SSL=true

AUTH_HTTP_TIMEOUT_SECONDS=10
AUTH_TRANSACTION_TTL_SECONDS=300
AUTH_DISCOVERY_CACHE_SECONDS=300
AUTH_JWKS_CACHE_SECONDS=300
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_ALLOWED_ALGORITHMS=RS256,ES256
AUTH_POLICY_VERSION=tpl-admin-v1
# Provider claims are authority inputs only after this local allowlist filter.
AUTH_ROLE_ALLOWLIST=admin,operator
AUTH_SCOPE_ALLOWLIST=tpl:admin

FRONTEND_BASE_URL=https://admin.example.test
FRONTEND_ALLOWED_ORIGINS=https://admin.example.test
ALLOWED_HOSTS=admin.example.test
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true

# Optional Celery producer/worker. Credentials belong in a Secret.
# CELERY_BROKER_URL=amqp://tpl-admin-producer:change-me@localhost:5672/tpl
CELERY_QUEUE=tpl.admin.default
# CELERY_RESULT_BACKEND=redis://tpl-worker:change-me@localhost:6379/0
