{
  "apiVersion": "search.sunmoonai.com/v1alpha1",
  "kind": "ElasticsearchAccess",
  "metadata": {
    "name": "tpl-backend"
  },
  "spec": {
    "provider": "platform-elasticsearch",
    "environment": "development",
    "app": "tpl-app",
    "backend": "tpl-backend",
    "namespace": "app-platform-dev",
    "secretName": "tpl-backend-elasticsearch",
    "configMapName": "tpl-backend-elasticsearch",
    "datasets": [
      {
        "name": "backend-documents",
        "schemaVersion": 1,
        "permissions": ["read", "write"],
        "settings": {},
        "mappings": {
          "dynamic": false,
          "properties": {
            "document_id": {"type": "keyword"},
            "title": {"type": "text"},
            "content": {"type": "text"},
            "updated_at": {"type": "date"}
          }
        }
      }
    ]
  }
}
